# Application
APP_ENV=development
DEBUG=true
SEED_ON_STARTUP=true

# Database (Docker Compose default)
# The API runs as the restricted apexbooks_api role (RLS enforced, no superuser).
# DB_PASSWORD is the bootstrap superuser password used only by the init script.
DB_PASSWORD=production_secure_db_pass
DB_MIGRATOR_PASSWORD=replace_with_a_strong_migrator_password
DB_API_PASSWORD=replace_with_a_strong_api_password
DB_WORKER_PASSWORD=replace_with_a_strong_worker_password
DATABASE_URL=postgresql://apexbooks_api:replace_with_a_strong_api_password@db:5432/bookkeeping
# Migrations use the privileged migrator role; never point the app at it.
MIGRATION_DATABASE_URL=postgresql://apexbooks_migrator:replace_with_a_strong_migrator_password@db:5432/bookkeeping
# Celery workers use their own restricted role.
WORKER_DATABASE_URL=postgresql://apexbooks_worker:replace_with_a_strong_worker_password@db:5432/bookkeeping

# Idempotency
# Financial mutations (invoice/bill/payment/journal creation) REQUIRE an
# Idempotency-Key header so client retries can never double-post money
# movements.  Set to false only for legacy clients that predate the rule.
REQUIRE_IDEMPOTENCY_KEY=true

# Redis (Docker Compose default)
REDIS_URL=redis://redis:6379/0

# JWT Authentication (REQUIRED — generate a strong secret for production)
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOYING_TO_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://apexbooks.in,https://api.apexbooks.in,tauri://localhost,tauri://com.apexbooks.desktop

# Email (SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@apexbooks.in

# OCR / Bill Scanning (vision LLM)
# Leave NVIDIA_NIM_API_KEY empty for gateways that need no auth (e.g. Omniroute).
# NVIDIA_NIM_BASE_URL is an OpenAI-compatible /v1 endpoint; empty = NVIDIA hosted NIM.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=APEXBOOKS
# Comma-separated fallback vision models tried when the primary fails/unusable.
# Direct model ids work on the gateway too (e.g. meta/llama-3.2-11b-vision-instruct).
NVIDIA_NIM_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct,auto/best-vision,auto/pro-vision,auto/multimodal,auto/vision
# Transient-error retries (429/5xx/network) after the first attempt.
NVIDIA_NIM_MAX_RETRIES=2
NVIDIA_NIM_TIMEOUT_SECONDS=90
# Max PDF pages the vision pipeline walks looking for bill content.
SCAN_MAX_PDF_PAGES=5

# File Storage (S3-compatible)
S3_BUCKET=bookkeeping-documents
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IRP (Invoice Registration Portal) — NIC e-Invoice
IRP_BASE_URL=https://einvoice1-sandbox.nic.in
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
COMPLIANCE_MOCK_ENABLED=false

# Rate Limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REPORTS=60/minute
RATE_LIMIT_DEFAULT=200/minute
